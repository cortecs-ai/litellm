{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run cortecs tests",
      "type": "shell",
      "command": "poetry run pytest litellm/cortecs/",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
